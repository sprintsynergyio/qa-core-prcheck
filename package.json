{
  "name": "@sprintsynergy/qa-core-prcheck",
  "version": "0.2.1",
  "description": "CI PR check agent: reads a pull request diff, picks the related Playwright tests, runs them and posts a pass or fail summary.",
  "keywords": [
    "playwright",
    "pull-request",
    "github-actions",
    "test-impact-analysis",
    "test-selection",
    "ci",
    "qa",
    "testing",
    "cli"
  ],
  "homepage": "https://github.com/sprintsynergyio/qa-core-prcheck#readme",
  "bugs": {
    "url": "https://github.com/sprintsynergyio/qa-core-prcheck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sprintsynergyio/qa-core-prcheck.git"
  },
  "license": "MIT",
  "author": {
    "name": "SprintSynergy",
    "url": "https://sprintsynergy.com"
  },
  "contributors": [
    {
      "name": "Muhammad Usman",
      "url": "https://linkedin.com/in/sdet-muhammadusman"
    }
  ],
  "type": "module",
  "engines": { "node": ">=22.6" },
  "bin": { "qa-core-prcheck": "dist/cli.js" },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/release-acceptance.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "eval": "npm run build && node evals/run.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "demo:list": "playwright test -c demo/saucedemo/playwright.config.ts --list",
    "demo:test": "playwright test -c demo/saucedemo/playwright.config.ts"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.60.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
